<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>nz.co.trademe</groupId>
  <artifactId>trademe-categorydetails-perftest</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Trade Me Category Details - JUnit/JMeter Performance Test</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Keep the embedded engine on exactly the same version as the shipped test plan. -->
    <jmeter.version>5.6.3</jmeter.version>
    <!-- Groovy version bundled by JMeter 5.6.3 (lib/groovy-3.0.20.jar) - used by the
         JSR223 assertion and CSV writer inside the test plan. -->
    <groovy.version>3.0.20</groovy.version>
    <gson.version>2.11.0</gson.version>
    <junit.version>5.10.2</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <!-- Performance test output directory: default to sibling folder "results" (parallel to maven project folder) -->
    <perf.output.dir>${project.basedir}/../results</perf.output.dir>
    <!-- Tag routing:
           mvn test                                   -> contract + unit tests (fast)
           mvn test -Djunit.excludedGroups=           -> everything, incl. the load suite
           mvn test -Djunit.groups=load -Djunit.excludedGroups= -> only the load suite -->
    <junit.groups></junit.groups>
    <junit.excludedGroups>load</junit.excludedGroups>
  </properties>

  <dependencies>
    <!-- Embedded JMeter engine. These artifacts are identical to the jars shipped in
         apache-jmeter-5.6.3/lib/ext, so results are byte-compatible with CLI runs. -->
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_core</artifactId>
      <version>${jmeter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_http</artifactId>
      <version>${jmeter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_functions</artifactId>
      <version>${jmeter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_components</artifactId>
      <version>${jmeter.version}</version>
    </dependency>

    <!-- JSR223 scripts inside the test plan are written in Groovy (JsonSlurper). -->
    <dependency>
      <groupId>org.codehaus.groovy</groupId>
      <artifactId>groovy</artifactId>
      <version>${groovy.version}</version>
    </dependency>
    <dependency>
      <groupId>org.codehaus.groovy</groupId>
      <artifactId>groovy-json</artifactId>
      <version>${groovy.version}</version>
    </dependency>

    <!-- JSON parsing for the pure-JUnit contract tests. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
	<dependency>
    <groupId>org.junit.platform</groupId>
    <artifactId>junit-platform-console</artifactId>
    <version>1.10.3</version>
    <scope>test</scope>
	</dependency>
	<dependency>
		<groupId>org.junit.jupiter</groupId>
		<artifactId>junit-jupiter-engine</artifactId>
		<version>5.10.3</version>
		<scope>test</scope>
	</dependency>
  </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven‑surefire‑plugin</artifactId>
				<version>${surefire.version}</version>
				<configuration>
					<systemPropertyVariables>
						<perf.output.dir>${perf.output.dir}</perf.output.dir>
					</systemPropertyVariables>
					<groups>${junit.groups}</groups>
					<excludedGroups>${junit.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven‑shade‑plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedTestArtifact>true</shadedTestArtifact>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.junit.platform.console.ConsoleLauncher</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
